# Copy to .env.dev / .env.stg / .env.prod and fill in real values. NEVER commit them.
# Non-secret config (URLs, timeouts, flags) belongs in lib/core/config/settings.yaml.
#
# One file per environment — env_config.py picks .env.<ENV> automatically:
#     ENV=stg python -m lib.app.main.main ...   ->  loads .env.stg
#     --env prod (CLI)                          ->  loads .env.prod
#
# Precedence, highest first:
#   1. real process environment variables (CI secrets, `ENV=stg make test`)
#   2. .env.<ENV>          per-environment secrets
#   3. .env                optional shared base for values identical in all three
#
# In CI no .env* files exist — inject these as secrets instead.
#
# Frontend URL/login is per subsidiary (each logs into a separate country domain),
# so FE_URL/FE_USERNAME/FE_PASSWORD/BE_API_TOKEN are suffixed with the subsidiary
# code. Add a subsidiary here only after adding it to settings.yaml's
# `defaults.subsidiaries` list.

# --- target environment ---
# one of: dev | stg | prod
ENV=dev
# one of: MJP | KOR | USA -> selects which _<SUBSIDIARY> credential set below is active
SUBSIDIARY=MJP
# one of: real | test  -> selects test_data/<module>/<env>/<subsidiary>/<DATA_SET>/
DATA_SET=test

# --- frontend / backend credentials, per subsidiary ---
FE_URL_MJP=https://dummy-mjp.example.internal
FE_USERNAME_MJP=dummy_user_mjp
FE_PASSWORD_MJP=dummy_password_mjp
BE_API_TOKEN_MJP=dummy_token_mjp

FE_URL_KOR=https://dummy-kor.example.internal
FE_USERNAME_KOR=dummy_user_kor
FE_PASSWORD_KOR=dummy_password_kor
BE_API_TOKEN_KOR=dummy_token_kor

FE_URL_USA=https://dummy-usa.example.internal
FE_USERNAME_USA=dummy_user_usa
FE_PASSWORD_USA=dummy_password_usa
BE_API_TOKEN_USA=dummy_token_usa

# --- backend / api (not subsidiary-specific) ---
BE_CLIENT_ID=dummy_client_id
BE_CLIENT_SECRET=dummy_client_secret

# --- postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ndf
POSTGRES_USER=dummy_user
POSTGRES_PASSWORD=dummy_password

# --- mongodb ---
MONGO_URI=mongodb://dummy_user:dummy_password@localhost:27017
MONGO_DB=ndf

# --- opensearch ---
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=dummy_user
OPENSEARCH_PASSWORD=dummy_password
OPENSEARCH_USE_SSL=false

# --- aws / s3 ---
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=dummy_access_key
AWS_SECRET_ACCESS_KEY=dummy_secret_key
S3_BUCKET=dummy-bucket
